{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/acquisition-job.schema.json",
  "title": "OSINT Acquisition Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "case_id",
    "query_plan_id",
    "pivot_id",
    "stream",
    "state",
    "execution_profile",
    "safety_class",
    "authorization",
    "inputs",
    "schedule",
    "output",
    "parser",
    "raw_output_hash",
    "normalized_output_hash",
    "run_manifest_hash",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": "father-osint.acquisition-job.v0.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^JOB-[A-Z0-9-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "query_plan_id": {
      "type": "string",
      "pattern": "^QPLAN-[A-Z0-9-]+$"
    },
    "pivot_id": {
      "type": "string",
      "pattern": "^PVT-[A-Z0-9-]+$"
    },
    "stream": {
      "enum": [
        "ENTITY_REGISTRY",
        "BUSINESS_TRANSACTIONS_LOGISTICS",
        "DIGITAL_FOOTPRINT",
        "LEGAL_SANCTIONS_ADVERSE",
        "RED_TEAM_SOURCE_QUALITY"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "transform_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^TRN-[A-Z0-9-]+$"
    },
    "tool_adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "PLANNED",
        "QUEUED",
        "RUNNING",
        "FOUND",
        "NO_HIT",
        "BLOCKED",
        "ERROR",
        "CANCELLED",
        "REVIEWED"
      ]
    },
    "execution_profile": {
      "enum": [
        "FIXTURE_ONLY",
        "WINDOWS_NATIVE",
        "WSL2_KALI",
        "CONTAINER_ISOLATED",
        "REMOTE_SANDBOX",
        "MANUAL_EXTERNAL"
      ]
    },
    "safety_class": {
      "enum": [
        "PASSIVE_PUBLIC",
        "ACTIVE_AUTHORIZED",
        "RESTRICTED_FORENSIC",
        "PROHIBITED"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_scope_checked",
        "policy_decision",
        "human_approval_required",
        "human_approval_obtained",
        "approved_by",
        "allowed_access_classes"
      ],
      "properties": {
        "case_scope_checked": {
          "const": true
        },
        "policy_decision": {
          "enum": [
            "ALLOW",
            "DENY",
            "REQUIRE_APPROVAL"
          ]
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "human_approval_obtained": {
          "type": "boolean"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_access_classes": {
          "type": "array",
          "items": {
            "enum": [
              "PUBLIC",
              "PUBLIC_WITH_PERSONAL_DATA",
              "AUTHORIZED_INTERNAL",
              "RESTRICTED",
              "PROHIBITED"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_type",
          "reference",
          "value_hash"
        ],
        "properties": {
          "input_type": {
            "enum": [
              "PERSON",
              "ORGANIZATION",
              "ADDRESS",
              "DOMAIN",
              "PHONE",
              "EMAIL",
              "DOCUMENT",
              "CONTRACT",
              "CASE",
              "ASSET",
              "WALLET",
              "TRANSACTION",
              "EVENT",
              "SOURCE",
              "CLAIM",
              "RISK",
              "QUERY",
              "FILE_REFERENCE"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "value_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queued_at_utc",
        "started_at_utc",
        "finished_at_utc",
        "timeout_seconds",
        "attempt"
      ],
      "properties": {
        "queued_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "started_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_code",
        "summary",
        "source_ids",
        "capture_ids",
        "entity_ids",
        "relation_ids",
        "claim_ids",
        "finding_ids",
        "research_gap_ids",
        "error_code"
      ],
      "properties": {
        "result_code": {
          "enum": [
            "FOUND",
            "NO_HIT",
            "BLOCKED",
            "CONFLICT",
            "ERROR",
            "CANCELLED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "capture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ENT-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REL-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLM-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FND-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "research_gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^GAP-[A-Z0-9-]+$"
          },
          "uniqueItems": true
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "output_contract"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "output_contract": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "raw_output_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalized_output_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
