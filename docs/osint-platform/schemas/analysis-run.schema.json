{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/analysis-run.schema.json",
  "title": "Analysis Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "task_id", "task", "input_refs", "input_bundle_sha256", "analyzer_ids", "independent_first_pass", "started_at_utc", "completed_at_utc", "policy_decision", "fact_promotion_allowed"],
  "properties": {
    "schema_version": {"const": "father-osint.analysis-run.v0.1"},
    "run_id": {"type": "string", "pattern": "^ARUN-[0-9]{4,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "task": {"type": "string", "minLength": 5},
    "input_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analyzer_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
    "independent_first_pass": {"const": true},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "policy_decision": {"enum": ["ALLOW", "ALLOW_WITH_REDACTION", "DENY"]},
    "fact_promotion_allowed": {"const": false},
    "prompt_template_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
