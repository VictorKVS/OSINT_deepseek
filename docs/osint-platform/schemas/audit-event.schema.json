{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/audit-event.schema.json",
  "title": "Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "case_id", "actor_type", "actor_id", "action", "object_type", "object_id", "timestamp_utc", "justification", "policy_decision", "previous_hash", "new_hash"],
  "properties": {
    "schema_version": {"const": "father-osint.audit-event.v0.1"},
    "event_id": {"type": "string", "pattern": "^AUD-[0-9]{4,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "actor_type": {"enum": ["HUMAN", "SERVICE", "ANALYZER", "TOOL"]},
    "actor_id": {"type": "string", "minLength": 2},
    "action": {"type": "string", "minLength": 3},
    "object_type": {"type": "string", "minLength": 2},
    "object_id": {"type": "string", "minLength": 2},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "justification": {"type": "string", "minLength": 5},
    "policy_decision": {"enum": ["ALLOW", "ALLOW_WITH_CONDITIONS", "DENY"]},
    "previous_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "new_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "conditions": {"type": "array", "items": {"type": "string"}}
  }
}
