{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/case.schema.json",
  "title": "OSINT Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "title", "case_type", "purpose", "status", "access_class", "legal_basis_or_usage_note", "created_at_utc", "owner_role", "scope", "synthetic"],
  "properties": {
    "schema_version": {"const": "father-osint.case.v0.1"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 300},
    "case_type": {"enum": ["CORPORATE_DUE_DILIGENCE", "THREAT_INTELLIGENCE", "BRAND_PROTECTION", "SUPPLIER_RISK", "REGULATORY_INTELLIGENCE", "MEDIA_NARRATIVE_ANALYSIS", "AUTHORIZED_SECURITY_ASSESSMENT", "SYNTHETIC_TRAINING"]},
    "purpose": {"type": "string", "minLength": 10},
    "status": {"enum": ["DRAFT", "AUTHORIZED", "COLLECTING", "ANALYZING", "REVIEW", "APPROVED", "CLOSED", "SUPERSEDED"]},
    "access_class": {"enum": ["PUBLIC", "PUBLIC_WITH_PERSONAL_DATA", "AUTHORIZED_INTERNAL", "RESTRICTED", "PROHIBITED"]},
    "legal_basis_or_usage_note": {"type": "string", "minLength": 10},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "owner_role": {"type": "string", "minLength": 3},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "excluded", "jurisdictions", "allowed_source_classes", "active_actions_allowed"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "jurisdictions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "allowed_source_classes": {"type": "array", "items": {"enum": ["PUBLIC", "PUBLIC_WITH_PERSONAL_DATA", "AUTHORIZED_INTERNAL", "RESTRICTED", "PROHIBITED"]}, "minItems": 1},
        "active_actions_allowed": {"type": "boolean"}
      }
    },
    "retention_rule": {"type": "string"},
    "related_requirement_issues": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "synthetic": {"type": "boolean"},
    "classification_decision": {"type": "string"}
  }
}
