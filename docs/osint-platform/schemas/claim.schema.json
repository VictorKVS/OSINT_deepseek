{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/claim.schema.json",
  "title": "Source Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "case_id", "source_ids", "statement", "representation", "locator", "subject_entity_ids", "status", "access_class"],
  "properties": {
    "schema_version": {"const": "father-osint.claim.v0.1"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"}, "minItems": 1, "uniqueItems": true},
    "statement": {"type": "string", "minLength": 3},
    "representation": {"enum": ["EXACT_QUOTE", "FAITHFUL_PARAPHRASE", "STRUCTURED_EXTRACTION"]},
    "locator": {"type": "string", "minLength": 1},
    "subject_entity_ids": {"type": "array", "items": {"type": "string", "pattern": "^ENT-[0-9]{4,}$"}, "minItems": 1},
    "predicate": {"type": "string"},
    "object_entity_ids": {"type": "array", "items": {"type": "string", "pattern": "^ENT-[0-9]{4,}$"}},
    "object_text": {"type": "string"},
    "status": {"const": "SOURCE_CLAIM"},
    "access_class": {"enum": ["PUBLIC", "PUBLIC_WITH_PERSONAL_DATA", "AUTHORIZED_INTERNAL", "RESTRICTED", "PROHIBITED"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
