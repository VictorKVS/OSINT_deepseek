{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/entity-match.schema.json",
  "title": "OSINT Entity Resolution Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_match_id",
    "case_id",
    "entity_a_id",
    "entity_b_id",
    "status",
    "same_entity_probability",
    "features",
    "supporting_features",
    "contradicting_features",
    "missing_decisive_evidence",
    "method",
    "human_review",
    "automatic_merge_performed",
    "created_at_utc",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": "father-osint.entity-match.v0.1"
    },
    "entity_match_id": {
      "type": "string",
      "pattern": "^EMATCH-[A-Z0-9-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "entity_a_id": {
      "type": "string",
      "pattern": "^ENT-[A-Z0-9-]+$"
    },
    "entity_b_id": {
      "type": "string",
      "pattern": "^ENT-[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "PROBABLE_MATCH",
        "CONFIRMED_SAME",
        "CONFIRMED_DISTINCT",
        "REJECTED",
        "NEEDS_REVIEW"
      ]
    },
    "same_entity_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_identifier",
        "name_similarity",
        "address_overlap",
        "temporal_consistency",
        "source_quality"
      ],
      "properties": {
        "exact_identifier": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "name_similarity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "address_overlap": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "temporal_consistency": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "supporting_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "description",
          "source_ids"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "contradicting_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature",
          "description",
          "source_ids"
        ],
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "missing_decisive_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "ruleset_or_model_hash"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ruleset_or_model_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer_role",
        "reviewed_at_utc",
        "decision_note"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "ESCALATED"
          ]
        },
        "reviewer_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_note": {
          "type": "string"
        }
      }
    },
    "automatic_merge_performed": {
      "const": false
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
