{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/graph-view.schema.json",
  "title": "OSINT Derived Graph View Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_view_id",
    "case_id",
    "purpose",
    "generated_at_utc",
    "authoritative",
    "mode",
    "query_context",
    "nodes",
    "edges",
    "evidence_paths",
    "unresolved_research_gap_ids",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": "father-osint.graph-view.v0.1"
    },
    "graph_view_id": {
      "type": "string",
      "pattern": "^GVIEW-[A-Z0-9-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 5
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "authoritative": {
      "const": false
    },
    "mode": {
      "enum": [
        "SEARCH_TABLE",
        "GRAPH",
        "MAP_TIMELINE",
        "DOSSIER",
        "REPORT_PATH"
      ]
    },
    "query_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_refs",
        "filters",
        "bounded_hops"
      ],
      "properties": {
        "seed_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounded_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "object_type",
          "subtype",
          "label",
          "status",
          "access_class",
          "source_ids",
          "position"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 2
          },
          "object_type": {
            "enum": [
              "CASE",
              "ENTITY",
              "SOURCE",
              "SOURCE_CAPTURE",
              "CLAIM",
              "RELATION",
              "FINDING",
              "RISK",
              "RESEARCH_GAP"
            ]
          },
          "subtype": {
            "type": "string",
            "minLength": 2
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 2
          },
          "access_class": {
            "enum": [
              "PUBLIC",
              "PUBLIC_WITH_PERSONAL_DATA",
              "AUTHORIZED_INTERNAL",
              "RESTRICTED",
              "PROHIBITED"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from_node_id",
          "to_node_id",
          "relation_type",
          "semantic_status",
          "relation_id",
          "source_ids",
          "confidence_grade",
          "evidence_path_id"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 2
          },
          "from_node_id": {
            "type": "string",
            "minLength": 2
          },
          "to_node_id": {
            "type": "string",
            "minLength": 2
          },
          "relation_type": {
            "type": "string",
            "minLength": 2
          },
          "semantic_status": {
            "enum": [
              "SOURCE_CLAIM",
              "FACT",
              "INFERENCE",
              "HYPOTHESIS",
              "DERIVED_NAVIGATION"
            ]
          },
          "relation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          },
          "confidence_grade": {
            "enum": [
              "A_CONFIRMED",
              "B_HIGHLY_PROBABLE",
              "C_ANALYTICAL_HYPOTHESIS",
              "D_LEAD",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_path_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_path_id",
          "target_ref",
          "steps",
          "limitations"
        ],
        "properties": {
          "evidence_path_id": {
            "type": "string",
            "pattern": "^EPATH-[A-Z0-9-]+$"
          },
          "target_ref": {
            "type": "string",
            "minLength": 2
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "object_type",
                "object_id",
                "role"
              ],
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "object_type": {
                  "enum": [
                    "SOURCE",
                    "SOURCE_CAPTURE",
                    "CLAIM",
                    "ENTITY",
                    "RELATION",
                    "ANALYSIS_OPINION",
                    "CONSENSUS",
                    "FINDING",
                    "RISK",
                    "RECOMMENDATION"
                  ]
                },
                "object_id": {
                  "type": "string",
                  "minLength": 2
                },
                "role": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unresolved_research_gap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GAP-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
