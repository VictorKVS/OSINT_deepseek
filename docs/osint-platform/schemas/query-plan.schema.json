{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/query-plan.schema.json",
  "title": "OSINT Human-Governed Query Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_plan_id",
    "case_id",
    "objective",
    "mode",
    "status",
    "created_at_utc",
    "created_by",
    "seed_entity_ids",
    "known_fact_ids",
    "unknowns",
    "pivots",
    "legal_constraints",
    "stop_conditions",
    "expected_cost_time",
    "human_approval",
    "plan_hash",
    "synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": "father-osint.query-plan.v0.1"
    },
    "query_plan_id": {
      "type": "string",
      "pattern": "^QPLAN-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "mode": {
      "enum": [
        "IDENTIFY",
        "INVESTIGATE",
        "MONITOR"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "AWAITING_APPROVAL",
        "APPROVED",
        "REJECTED",
        "EXECUTING",
        "COMPLETED",
        "SUPERSEDED"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "version"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 2
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "AGENT",
            "RULE_ENGINE"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seed_entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ENT-[A-Z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "known_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FND-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "question",
          "why_matters",
          "priority",
          "stream",
          "status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^Q-[A-Z0-9-]+$"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "why_matters": {
            "type": "string",
            "minLength": 5
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "stream": {
            "enum": [
              "ENTITY_REGISTRY",
              "BUSINESS_TRANSACTIONS_LOGISTICS",
              "DIGITAL_FOOTPRINT",
              "LEGAL_SANCTIONS_ADVERSE",
              "RED_TEAM_SOURCE_QUALITY"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "PLANNED",
              "IN_PROGRESS",
              "ANSWERED",
              "NO_HIT",
              "BLOCKED",
              "WAIVED"
            ]
          }
        }
      }
    },
    "pivots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pivot_id",
          "stream",
          "query_or_action",
          "input_entity_ids",
          "source_family",
          "execution_mode",
          "expected_output_types",
          "priority",
          "status",
          "access_class",
          "dependencies",
          "timeout_seconds"
        ],
        "properties": {
          "pivot_id": {
            "type": "string",
            "pattern": "^PVT-[A-Z0-9-]+$"
          },
          "stream": {
            "enum": [
              "ENTITY_REGISTRY",
              "BUSINESS_TRANSACTIONS_LOGISTICS",
              "DIGITAL_FOOTPRINT",
              "LEGAL_SANCTIONS_ADVERSE",
              "RED_TEAM_SOURCE_QUALITY"
            ]
          },
          "query_or_action": {
            "type": "string",
            "minLength": 3
          },
          "input_entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ENT-[A-Z0-9-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source_family": {
            "type": "string",
            "minLength": 2
          },
          "execution_mode": {
            "enum": [
              "FIXTURE_ONLY",
              "BROWSER",
              "API",
              "DOWNLOAD",
              "CONNECTOR",
              "MANUAL_EXTERNAL"
            ]
          },
          "expected_output_types": {
            "type": "array",
            "items": {
              "enum": [
                "PERSON",
                "ORGANIZATION",
                "ADDRESS",
                "DOMAIN",
                "PHONE",
                "EMAIL",
                "DOCUMENT",
                "CONTRACT",
                "CASE",
                "ASSET",
                "WALLET",
                "TRANSACTION",
                "EVENT",
                "SOURCE",
                "CLAIM",
                "RISK",
                "SOURCE_CAPTURE",
                "RELATION",
                "FINDING",
                "RESEARCH_GAP"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "APPROVAL_REQUIRED",
              "RUNNING",
              "COMPLETED",
              "CANCELLED",
              "SUPERSEDED"
            ]
          },
          "access_class": {
            "enum": [
              "PUBLIC",
              "PUBLIC_WITH_PERSONAL_DATA",
              "AUTHORIZED_INTERNAL",
              "RESTRICTED",
              "PROHIBITED"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PVT-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "max_requests": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "legal_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "expected_cost_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_jobs",
        "estimated_minutes",
        "max_network_requests",
        "estimate_basis"
      ],
      "properties": {
        "estimated_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_minutes": {
          "type": "number",
          "minimum": 0
        },
        "max_network_requests": {
          "type": "integer",
          "minimum": 0
        },
        "estimate_basis": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer_id",
        "reviewed_at_utc",
        "note"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
