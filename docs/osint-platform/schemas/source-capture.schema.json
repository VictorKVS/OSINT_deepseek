{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/source-capture.schema.json",
  "title": "Source Capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_id", "source_id", "case_id", "captured_at_utc", "capture_method", "mime_type", "sha256", "storage_uri", "immutable", "collector_id", "collector_version", "access_class", "legal_basis_or_usage_note", "raw_preserved", "integrity_verified"],
  "properties": {
    "schema_version": {"const": "father-osint.source-capture.v0.1"},
    "capture_id": {"type": "string", "pattern": "^CAP-[0-9]{4,}$"},
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "capture_method": {"enum": ["HTTP_GET", "BROWSER_SAVE", "API_EXPORT", "MANUAL_UPLOAD", "SCREENSHOT", "ARCHIVE_FETCH", "OTHER"]},
    "mime_type": {"type": "string", "minLength": 3},
    "byte_size": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storage_uri": {"type": "string", "minLength": 5},
    "immutable": {"const": true},
    "collector_id": {"type": "string", "minLength": 2},
    "collector_version": {"type": "string", "minLength": 1},
    "access_class": {"enum": ["PUBLIC", "PUBLIC_WITH_PERSONAL_DATA", "AUTHORIZED_INTERNAL", "RESTRICTED", "PROHIBITED"]},
    "legal_basis_or_usage_note": {"type": "string", "minLength": 5},
    "raw_preserved": {"const": true},
    "integrity_verified": {"type": "boolean"},
    "quarantine_status": {"enum": ["NOT_REQUIRED", "PENDING", "PASSED", "FAILED"]}
  }
}
