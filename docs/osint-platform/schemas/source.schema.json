{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/osint-platform/source.schema.json",
  "title": "OSINT Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "case_id", "url", "title", "publisher", "source_type", "primary_level", "accessed_at_utc", "jurisdiction", "language", "affiliation", "bias_or_interest", "reliability_grade", "what_it_supports", "what_it_does_not_support", "access_class", "legal_basis_or_usage_note", "republication_status"],
  "properties": {
    "schema_version": {"const": "father-osint.source.v0.1"},
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4,}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["OFFICIAL_REGISTER", "OFFICIAL_DOCUMENT", "COURT", "REGULATOR", "COMPANY_PUBLICATION", "NEWS", "INVESTIGATIVE_REPORT", "SOCIAL_PUBLIC", "WEB_PAGE", "ARCHIVE", "DATASET", "OTHER"]},
    "primary_level": {"enum": ["PRIMARY", "SECONDARY", "TERTIARY", "UNKNOWN"]},
    "accessed_at_utc": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "jurisdiction": {"type": "string", "minLength": 2},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "affiliation": {"type": "string"},
    "bias_or_interest": {"type": "string"},
    "reliability_grade": {"enum": ["A_CONFIRMED", "B_HIGHLY_PROBABLE", "C_ANALYTICAL_HYPOTHESIS", "D_LEAD"]},
    "what_it_supports": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "what_it_does_not_support": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "access_class": {"enum": ["PUBLIC", "PUBLIC_WITH_PERSONAL_DATA", "AUTHORIZED_INTERNAL", "RESTRICTED", "PROHIBITED"]},
    "legal_basis_or_usage_note": {"type": "string", "minLength": 5},
    "republication_status": {"enum": ["ALLOWED", "METADATA_ONLY", "REDACTED_ONLY", "PROHIBITED", "UNKNOWN"]},
    "status": {"enum": ["ACTIVE", "STALE", "UNAVAILABLE", "SUPERSEDED", "REJECTED"]}
  }
}
