{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/check-result.schema.json",
  "title": "FATHER OSINT Check Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "work_item_id", "check_code", "outcome", "adapter_id", "observations", "source_attempts", "evidence_refs", "limitations", "conflicts", "next_actions", "human_review_required", "started_at_utc", "finished_at_utc", "duration_ms", "result_id"],
  "properties": {
    "request_id": {"type": "string"},
    "work_item_id": {"type": "string"},
    "check_code": {"type": "string"},
    "outcome": {"enum": ["FOUND", "NO_HIT_IN_SCOPE", "CONFLICT", "BLOCKED_NO_ADAPTER", "BLOCKED_POLICY", "BLOCKED_MISSING_IDENTIFIER", "ERROR", "NOT_APPLICABLE", "SKIPPED"]},
    "adapter_id": {"type": ["string", "null"]},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "classification", "evidence_refs", "source_ids", "limitations", "entity_refs", "observation_id"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "classification": {"enum": ["DIRECT_OBSERVATION", "SOURCE_CLAIM", "LEAD", "INFERENCE_CANDIDATE"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "entity_refs": {"type": "array", "items": {"type": "string"}},
          "observation_id": {"type": "string"}
        }
      }
    },
    "source_attempts": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "started_at_utc": {"type": ["string", "null"]},
    "finished_at_utc": {"type": ["string", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "result_id": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "FOUND"}}},
      "then": {"properties": {"observations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "NO_HIT_IN_SCOPE"}}},
      "then": {"properties": {"observations": {"maxItems": 0}, "source_attempts": {"minItems": 1}}}
    }
  ]
}
