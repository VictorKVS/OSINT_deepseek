{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.example/schemas/screening-request.schema.json",
  "title": "FATHER OSINT Screening Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "purpose", "legal_basis_note", "jurisdiction_scope", "depth", "risk_tier", "recheck_mode", "requested_by", "allowed_source_classes", "active_actions_allowed", "export_profile", "request_id", "case_id", "created_at_utc"],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "display_name", "country_code", "identifiers", "aliases", "citizenships", "known_regions", "access_class", "subject_id"],
      "properties": {
        "kind": {"enum": ["PERSON", "LEGAL_ENTITY"]},
        "display_name": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$|^ZZ$"},
        "identifiers": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "date_of_birth": {"type": ["string", "null"]},
        "incorporation_date": {"type": ["string", "null"]},
        "citizenships": {"type": "array", "items": {"type": "string"}},
        "known_regions": {"type": "array", "items": {"type": "string"}},
        "access_class": {"type": "string"},
        "subject_id": {"type": "string", "minLength": 5}
      }
    },
    "purpose": {"type": "string", "minLength": 10},
    "legal_basis_note": {"type": "string", "minLength": 10},
    "jurisdiction_scope": {"enum": ["RUSSIA", "FOREIGN"]},
    "depth": {"enum": ["BASIC", "STANDARD", "ENHANCED", "DEEP"]},
    "risk_tier": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "recheck_mode": {"enum": ["INITIAL", "PERIODIC", "EVENT_DRIVEN", "MANUAL_REVIEW"]},
    "requested_by": {"type": "string", "minLength": 1},
    "allowed_source_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "active_actions_allowed": {"const": false},
    "export_profile": {"type": "string"},
    "request_id": {"type": "string", "minLength": 5},
    "case_id": {"type": "string", "minLength": 5},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
