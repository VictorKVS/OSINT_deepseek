{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/father_analyst_promotion_request.schema.json",
  "title": "FATHER Analyst M4 Promotion Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_request_id",
    "case_id",
    "object_ref",
    "object_type",
    "object_version",
    "review_decision",
    "reviewed_by",
    "reviewed_at",
    "evidence_bindings",
    "reasoning_bindings",
    "request_sha256",
    "direct_kb_write_allowed"
  ],
  "properties": {
    "schema_version": {"const": "m4.0"},
    "promotion_request_id": {"type": "string", "pattern": "^PROM-[A-Z0-9][A-Z0-9_-]{1,95}$"},
    "case_id": {"type": "string", "pattern": "^CASE-[A-Z0-9][A-Z0-9_-]{1,95}$"},
    "object_ref": {"type": "string", "minLength": 1, "maxLength": 160},
    "object_type": {"enum": ["FACT", "RELATION", "CONCLUSION", "KNOWLEDGE_CANDIDATE"]},
    "object_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "review_decision": {"const": "PASS"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 160},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_record_ref": {"type": ["string", "null"], "maxLength": 256},
    "review_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_ref", "version_ref"],
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1},
          "version_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "reasoning_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reasoning_ref", "version_ref"],
        "properties": {
          "reasoning_ref": {"type": "string", "minLength": 1},
          "version_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "socrates_disposition": {"enum": ["PASS", "REWORK", "INCONCLUSIVE"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "direct_kb_write_allowed": {"const": false}
  }
}
