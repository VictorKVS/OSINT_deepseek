{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/father_analyst_tool_adapter.schema.json",
  "title": "FATHER Analyst M4 Tool Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "name",
    "version",
    "execution_profile",
    "input_types",
    "output_types",
    "possible_edge_types",
    "capabilities",
    "credential_requirements",
    "network_policy",
    "legal_mode",
    "parallelism_class",
    "rate_limit_policy",
    "cost_policy",
    "normalizer_version",
    "health_check",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "m4.0"},
    "tool_id": {"type": "string", "pattern": "^TOOL-[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {"type": "string", "minLength": 1, "maxLength": 120},
    "execution_profile": {
      "enum": ["WINDOWS_NATIVE", "WSL2_KALI", "PYTHON_ISOLATED", "CONTAINER_ISOLATED", "API_REMOTE_READONLY", "MANUAL_EXTERNAL"]
    },
    "input_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityType"}
    },
    "output_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityType"}
    },
    "possible_edge_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "credential_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "network_policy": {
      "enum": ["LOCAL_ONLY", "PASSIVE_PUBLIC", "API_READONLY", "MANUAL_EXTERNAL", "BLOCKED"]
    },
    "legal_mode": {
      "enum": ["PUBLIC_ONLY", "AUTHORIZED_INTERNAL", "AUTHORIZED_ASSESSMENT", "MANUAL_REVIEW_REQUIRED", "PROHIBITED"]
    },
    "parallelism_class": {
      "enum": ["CPU_LOCAL", "IO_LOCAL", "NETWORK_PASSIVE", "RATE_LIMITED_API", "GUI_MANUAL"]
    },
    "rate_limit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["NONE_KNOWN", "STATIC", "PROVIDER_DYNAMIC", "MANUAL"]},
        "max_concurrency": {"type": ["integer", "null"], "minimum": 1},
        "requests_per_window": {"type": ["integer", "null"], "minimum": 1},
        "window_seconds": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "cost_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["FREE_LOCAL", "FREE_PROVIDER_LIMITED", "CREDIT_METERED", "SUBSCRIPTION", "UNKNOWN"]},
        "notes": {"type": "string", "maxLength": 500}
      }
    },
    "normalizer_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["COMMAND", "API", "IMPORT", "MANUAL"]},
        "probe": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "status": {"enum": ["READY", "NEEDS_CONFIG", "OFFLINE", "EXPERIMENTAL", "PLANNED", "BLOCKED_BY_POLICY"]}
  },
  "$defs": {
    "entityType": {
      "type": "string",
      "enum": [
        "PERSON", "ORGANIZATION", "DOMAIN", "SUBDOMAIN", "IP", "ASN", "CERTIFICATE", "EMAIL", "PHONE", "USERNAME", "ACCOUNT", "PROFILE", "URL", "DOCUMENT", "MEDIA", "LOCATION", "DEVICE", "SERVICE", "PORT", "WALLET", "TRANSACTION", "MESSAGE", "CHANNEL", "REPOSITORY", "HASH", "CVE", "EVENT", "OTHER"
      ]
    }
  }
}
