{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://father.local/schemas/investigation_case.schema.json",
  "title": "FATHER OSINT Investigation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "status",
    "investigation_modes",
    "scope",
    "questions",
    "hypotheses",
    "entities",
    "relations",
    "findings",
    "evidence",
    "claims",
    "timeline",
    "conclusions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{4}-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {"enum": ["DRAFT", "ACTIVE", "REVIEW", "CLOSED", "ARCHIVED"]},
    "investigation_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["PERSON", "ORGANIZATION", "INFRASTRUCTURE", "TELEGRAM_SOCIAL", "CRYPTO", "DOCUMENT_REGULATORY", "MEDIA_NARRATIVE", "GEO", "INCIDENT_CAMPAIGN", "CUSTOM"]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "in_scope", "out_of_scope", "constraints"],
      "properties": {
        "purpose": {"type": "string"},
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/timeline_event"}},
    "conclusions": {"type": "array", "items": {"$ref": "#/$defs/conclusion"}},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  },
  "$defs": {
    "refId": {"type": "string", "minLength": 1, "maxLength": 160},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "text", "status"],
      "properties": {
        "question_id": {"$ref": "#/$defs/refId"},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "PARTIAL", "ANSWERED", "BLOCKED"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "text", "status", "supporting_evidence_ids", "counter_evidence_ids", "gap_ids"],
      "properties": {
        "hypothesis_id": {"$ref": "#/$defs/refId"},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "SUPPORTED", "WEAKENED", "REJECTED", "UNRESOLVED"]},
        "supporting_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "counter_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "gap_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "confidence_rationale": {"type": "string"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "label", "status"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/refId"},
        "entity_type": {"enum": ["PERSON", "ORGANIZATION", "ACCOUNT", "EMAIL", "PHONE", "DOMAIN", "IP", "URL", "WALLET", "TRANSACTION", "REPOSITORY", "DOCUMENT", "LOCATION", "MEDIA", "DEVICE", "OTHER"]},
        "label": {"type": "string", "minLength": 1},
        "status": {"enum": ["CANDIDATE", "VERIFIED", "DISPUTED", "MERGED", "REJECTED"]},
        "attributes": {"type": "object"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "from_entity_id", "to_entity_id", "relation_type", "evidence_ids", "status"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/refId"},
        "from_entity_id": {"$ref": "#/$defs/refId"},
        "to_entity_id": {"$ref": "#/$defs/refId"},
        "relation_type": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/refId"}},
        "status": {"enum": ["CANDIDATE", "SUPPORTED", "DISPUTED", "REJECTED"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "tool_id", "source_locator", "state"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/refId"},
        "tool_id": {"$ref": "#/$defs/refId"},
        "source_locator": {"type": "string", "minLength": 1},
        "raw_artifact_ref": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "state": {"enum": ["RAW", "TRIAGED", "REJECTED", "DUPLICATE", "OUT_OF_SCOPE"]},
        "question_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "hypothesis_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "finding_id", "state", "quality"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/refId"},
        "finding_id": {"$ref": "#/$defs/refId"},
        "state": {"enum": ["REVIEWED", "ACCEPTED_EVIDENCE", "REJECTED", "UNVERIFIED_SOURCE", "CONTRADICTED", "SUPERSEDED"]},
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_identity": {"enum": ["UNKNOWN", "WEAK", "MODERATE", "STRONG"]},
            "directness": {"enum": ["UNKNOWN", "SECONDARY", "PRIMARY"]},
            "provenance": {"enum": ["INCOMPLETE", "PARTIAL", "COMPLETE"]},
            "integrity": {"enum": ["UNKNOWN", "UNHASHED", "HASHED"]},
            "temporal_relevance": {"enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH"]},
            "independence": {"enum": ["UNKNOWN", "DERIVED", "INDEPENDENT"]},
            "consistency": {"enum": ["UNKNOWN", "CONFLICTING", "MIXED", "CONSISTENT"]}
          }
        },
        "analyst_note": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "status", "supporting_evidence_ids", "counter_evidence_ids"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/refId"},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["UNRESOLVED", "SUPPORTED", "CONTRADICTED", "REJECTED"]},
        "supporting_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "counter_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}}
      }
    },
    "timeline_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "label", "evidence_ids"],
      "properties": {
        "event_id": {"$ref": "#/$defs/refId"},
        "label": {"type": "string", "minLength": 1},
        "event_time": {"type": ["string", "null"]},
        "acquired_at": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/refId"}},
        "time_certainty": {"enum": ["UNKNOWN", "APPROXIMATE", "EXACT"]}
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion_id", "text", "status", "claim_ids", "evidence_ids", "remaining_gaps"],
      "properties": {
        "conclusion_id": {"$ref": "#/$defs/refId"},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["DRAFT", "REVIEWED", "FINAL"]},
        "claim_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/refId"}},
        "alternative_explanations": {"type": "array", "items": {"type": "string"}},
        "remaining_gaps": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
